{
  "description": "bounds",
  "schema": {
    "type": "object",
    "properties": {
      "n": {
        "type": "number",
        "minimum": 1,
        "maximum": 10,
        "multipleOf": 2
      },
      "s": {
        "type": "string",
        "minLength": 2,
        "maxLength": 4
      },
      "arr": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "uniqueItems": true,
        "items": {
          "type": "integer"
        }
      }
    }
  },
  "valid": [
    {
      "n": 2,
      "s": "ok",
      "arr": [
        1,
        2
      ]
    }
  ],
  "invalid": [
    {
      "n": 11
    },
    {
      "n": 3
    },
    {
      "s": "x"
    },
    {
      "arr": [
        1,
        1
      ]
    },
    {
      "arr": [
        1,
        2,
        3
      ]
    }
  ]
}
