  "compilerOptions": {
    "target": "es2023", "module": "esnext", "types": ["svelte", "vite/client"],
    "allowArbitraryExtensions": true, "noEmit": true, "allowJs": true, "checkJs": true
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte"]
