{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BaseHero",
  "identifier": "app.basehero",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{
      "title": "BaseHero", "width": 1100, "height": 760,
      "minWidth": 360, "minHeight": 480,
      "titleBarStyle": "Overlay", "hiddenTitle": true,
      "trafficLightPosition": { "x": 14, "y": 19 }
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; frame-src 'none'; worker-src 'none'; object-src 'none'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4RDMwREFDOTkwQ0E1MTcKUldRWHBReVpyQTNUS045VjVRWU1mOEE4bGtORTd1S21uZFJhUTk4MVVFTk02YjdGcGNObGpjQ0gK",
      "endpoints": ["https://github.com/BaseHero/basehero/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
