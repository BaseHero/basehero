{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "basehero-client-setup",
  "description": "First-account setup and joining an account by QR, only on the main window; no note-* window receives recovery-kit access.",
  "windows": ["main"],
  "permissions": [
    "allow-account-screen",
    "allow-account-retry",
    "allow-account-suggest-password",
    "allow-account-create",
    "allow-account-confirm-kit",
    "allow-account-return",
    "allow-account-print-kit",
    "allow-account-email-kit",
    "allow-account-save-kit-file",
    "allow-account-open-note",
    "allow-pairing-join",
    "allow-pairing-join-status"
  ]
}
