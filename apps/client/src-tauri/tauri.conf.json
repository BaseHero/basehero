{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BaseHero",
  "version": "0.1.0",
  "identifier": "app.basehero.client",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BaseHero",
        "width": 1000,
        "height": 760,
        "minWidth": 320,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 19 }
      }
    ],
    "security": {
      "capabilities": ["basehero-client-notes", "basehero-client-setup", "basehero-client-pairing", "basehero-client-window", "basehero-client-camera-scan"],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; worker-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../ui/icon.png", "../ui/icon.icns"]
  }
}
